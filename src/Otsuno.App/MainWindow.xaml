<Window x:Class="Otsuno.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Otsuno" Height="760" Width="1120" MinHeight="560" MinWidth="920"
        Background="#111315">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#181A1D" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#111315" />
        <SolidColorBrush x:Key="BorderBrush" Color="#30343A" />
        <SolidColorBrush x:Key="TextBrush" Color="#F4F7FB" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#B0B8C4" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8D98A8" />

        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="94" />
            <Setter Property="Padding" Value="14,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Otsuno" Foreground="{StaticResource TextBrush}" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Otaku Translation System by Unified Neural Operations." Foreground="{StaticResource SubtleTextBrush}" FontSize="13" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StartButton" Content="Start" Click="StartButton_Click" Margin="0,0,8,0" />
                <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click" IsEnabled="False" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Padding="14" Margin="0,18,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Current Status" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    <TextBlock x:Name="StatusText"
                               Text="Ready. Demo capture/OCR/translation services are wired."
                               Foreground="#D7DEE9"
                               FontSize="13"
                               Margin="0,4,16,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="OcrStatusText" Text="OCR: -" Foreground="#D7DEE9" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Padding="16,16,10,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Translation" Style="{StaticResource SectionTitleStyle}" />

                        <TextBlock Text="Model" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="TranslationModelCombo" SelectedIndex="0" Margin="0,0,0,18">
                            <ComboBoxItem Content="qwen2.5:1.5b" />
                            <ComboBoxItem Content="llama3.2:3b" />
                        </ComboBox>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Source" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="SourceLanguageCombo" SelectedIndex="0">
                                    <ComboBoxItem Content="Detect language" />
                                    <ComboBoxItem Content="ja" />
                                    <ComboBoxItem Content="en" />
                                    <ComboBoxItem Content="ko" />
                                    <ComboBoxItem Content="zh-Hans" />
                                    <ComboBoxItem Content="zh-Hant" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Target" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="TargetLanguageCombo" SelectedIndex="0">
                                    <ComboBoxItem Content="ja" />
                                    <ComboBoxItem Content="en" />
                                    <ComboBoxItem Content="ko" />
                                    <ComboBoxItem Content="zh-Hans" />
                                    <ComboBoxItem Content="zh-Hant" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,18" />

                        <TextBlock Text="Capture And OCR" Style="{StaticResource SectionTitleStyle}" />

                        <TextBlock Text="OCR Engine" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="OcrEngineCombo" SelectedIndex="0" Margin="0,0,0,18">
                            <ComboBoxItem Content="PaddleOCR" />
                            <ComboBoxItem Content="Windows OCR" />
                        </ComboBox>

                        <TextBlock Text="Preset" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="PipelinePresetCombo" SelectedIndex="0" Margin="0,0,0,18">
                            <ComboBoxItem Content="LowLatency" />
                            <ComboBoxItem Content="Balanced" />
                            <ComboBoxItem Content="Quality" />
                        </ComboBox>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Frequency" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock x:Name="TranslationFrequencyText"
                                       Grid.Column="1"
                                       Text="3/s"
                                       Foreground="#D7DEE9"
                                       FontSize="12"
                                       Margin="12,0,0,0" />
                            <Slider x:Name="TranslationFrequencySlider"
                                    Grid.ColumnSpan="2"
                                    Margin="0,22,0,0"
                                    Minimum="0.25"
                                    Maximum="4"
                                    Value="3"
                                    TickFrequency="0.25"
                                    IsSnapToTickEnabled="True" />
                        </Grid>

                        <CheckBox x:Name="DebugModeCheckBox"
                                  Content="Show debug overlay"
                                  Foreground="#D7DEE9"
                                  Margin="0,0,0,2" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource PanelBorderStyle}"
                    Background="{StaticResource SurfaceAltBrush}"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Logs" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                        <TextBlock Grid.Column="1" Text="Latest 300 lines" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
                    </Grid>

                    <RichTextBox Grid.Row="1"
                                 x:Name="LogText"
                                 Foreground="#D7DEE9"
                                 Background="{StaticResource SurfaceAltBrush}"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 IsUndoEnabled="False"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto">
                        <FlowDocument PagePadding="0" PageWidth="1000000">
                            <Paragraph Margin="0">
                                <Run Text="Ready." />
                            </Paragraph>
                        </FlowDocument>
                    </RichTextBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
