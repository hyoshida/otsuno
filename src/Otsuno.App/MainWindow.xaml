<Window x:Class="Otsuno.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Otsuno" Height="640" Width="980" MinHeight="520" MinWidth="820"
        Background="#10131A">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Otsuno" Foreground="#F4F7FB" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Automatic local game-screen translation foundation" Foreground="#A9B4C4" FontSize="13" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Model" Foreground="#A9B4C4" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="TranslationModelCombo" Width="138" SelectedIndex="0" Margin="0,0,12,0">
                    <ComboBoxItem Content="qwen2.5:1.5b" />
                    <ComboBoxItem Content="llama3.2:3b" />
                </ComboBox>
                <TextBlock Text="Target" Foreground="#A9B4C4" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="TargetLanguageCombo" Width="92" SelectedIndex="0" Margin="0,0,12,0">
                    <ComboBoxItem Content="ja" />
                    <ComboBoxItem Content="en" />
                    <ComboBoxItem Content="ko" />
                    <ComboBoxItem Content="zh" />
                </ComboBox>
                <Button x:Name="StartButton" Content="Start" Width="96" Click="StartButton_Click" Margin="0,0,8,0" />
                <Button x:Name="StopButton" Content="Stop" Width="96" Click="StopButton_Click" IsEnabled="False" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#171B24" BorderBrush="#293143" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,18,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready. Demo capture/OCR/translation services are wired." Foreground="#D7DEE9" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Overlay: source-near labels" Foreground="#8FA0B8" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Translations}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  Background="#10131A"
                  Foreground="#E7ECF3"
                  RowBackground="#151923"
                  AlternatingRowBackground="#111722"
                  BorderBrush="#293143"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Region" Binding="{Binding RegionId}" Width="130" />
                <DataGridTextColumn Header="Source" Binding="{Binding SourceText}" Width="*" />
                <DataGridTextColumn Header="Translation" Binding="{Binding TranslatedText}" Width="*" />
                <DataGridTextColumn Header="Bounds" Binding="{Binding BoundsText}" Width="170" />
                <DataGridCheckBoxColumn Header="Cached" Binding="{Binding FromCache}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
