<Window x:Class="Otsuno.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Otsuno" Height="640" Width="1100" MinHeight="520" MinWidth="900"
        Background="#10131A">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Otsuno" Foreground="#F4F7FB" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Automatic local game-screen translation foundation" Foreground="#A9B4C4" FontSize="13" />
            </StackPanel>

            <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Model" Foreground="#A9B4C4" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="TranslationModelCombo" Width="138" SelectedIndex="0" Margin="0,0,12,0">
                    <ComboBoxItem Content="qwen2.5:1.5b" />
                    <ComboBoxItem Content="llama3.2:3b" />
                </ComboBox>
                <TextBlock Text="Source" Foreground="#A9B4C4" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="SourceLanguageCombo" Width="128" SelectedIndex="0" Margin="0,0,12,0">
                    <ComboBoxItem Content="Detect language" />
                    <ComboBoxItem Content="ja" />
                    <ComboBoxItem Content="en" />
                    <ComboBoxItem Content="ko" />
                    <ComboBoxItem Content="zh-Hans" />
                    <ComboBoxItem Content="zh-Hant" />
                </ComboBox>
                <TextBlock Text="Target" Foreground="#A9B4C4" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="TargetLanguageCombo" Width="92" SelectedIndex="0" Margin="0,0,12,0">
                    <ComboBoxItem Content="ja" />
                    <ComboBoxItem Content="en" />
                    <ComboBoxItem Content="ko" />
                    <ComboBoxItem Content="zh-Hans" />
                    <ComboBoxItem Content="zh-Hant" />
                </ComboBox>
                <TextBlock Text="Preset" Foreground="#A9B4C4" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="PipelinePresetCombo" Width="108" SelectedIndex="0" Margin="0,0,12,0">
                    <ComboBoxItem Content="LowLatency" />
                    <ComboBoxItem Content="Balanced" />
                    <ComboBoxItem Content="Quality" />
                </ComboBox>
                <TextBlock Text="Frequency" Foreground="#A9B4C4" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider x:Name="TranslationFrequencySlider"
                        Width="130"
                        Minimum="0.25"
                        Maximum="4"
                        Value="3"
                        TickFrequency="0.25"
                        IsSnapToTickEnabled="True"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0" />
                <TextBlock x:Name="TranslationFrequencyText"
                           Width="54"
                           Text="3/s"
                           Foreground="#D7DEE9"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <CheckBox x:Name="DebugModeCheckBox"
                          Content="Debug"
                          Foreground="#D7DEE9"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0" />
                <Button x:Name="StartButton" Content="Start" Width="96" Click="StartButton_Click" Margin="0,0,8,0" />
                <Button x:Name="StopButton" Content="Stop" Width="96" Click="StopButton_Click" IsEnabled="False" />
            </WrapPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#171B24" BorderBrush="#293143" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,18,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready. Demo capture/OCR/translation services are wired." Foreground="#D7DEE9" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="OcrStatusText" Text="OCR: -" Foreground="#D7DEE9" Margin="0,0,16,0" />
                    <TextBlock Text="Overlay: source-near labels" Foreground="#8FA0B8" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="#10131A"
                BorderBrush="#293143"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Logs" Foreground="#F4F7FB" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBox Grid.Row="1"
                         x:Name="LogText"
                         Text="Ready."
                         Foreground="#D7DEE9"
                         Background="#10131A"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         IsUndoEnabled="False"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </Border>
    </Grid>
</Window>
